<Window x:Class="MattesAutoPerformance.Views.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autostartappar" Width="720" Height="560" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Icon="/app.ico"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Autostartappar" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Margin="0,6,0,12" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                       Text="Bocka ur appar som inte behöver starta när Windows startar. Ändringen gäller från nästa omstart och går alltid att ångra här eller i Aktivitetshanteraren." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Entries">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,4" Padding="14,10" CornerRadius="8" Background="{StaticResource CardBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding Enabled, Mode=OneTime}" VerticalAlignment="Center"
                                          Tag="{Binding}" Click="Entry_Click" />
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Source}" FontSize="12"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding Command}" FontSize="11" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource MutedTextBrush}" ToolTip="{Binding Command}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"
                       TextWrapping="Wrap" Margin="0,0,120,0" />
            <Button Content="Klar" HorizontalAlignment="Right" Style="{StaticResource AccentButton}"
                    IsDefault="True" IsCancel="True" Click="Close_Click" />
        </Grid>
    </Grid>
</Window>
